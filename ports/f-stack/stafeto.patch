+	${OBJCOPY} --localize-symbols=$*_localize_list.tmp $*.stack.ro
+	${OBJCOPY} --globalize-symbols=ff_api.symlist --wildcard --globalize-symbol='ff_stafeto_*' $*.stack.ro
