+	${OBJCOPY} --globalize-symbols=ff_api.symlist --globalize-symbols=$*_host_api.tmp --wildcard --globalize-symbol='ff_stafeto_*' $*.ro
+	rm $*_localize_list.tmp $*_host_api.tmp $*.stack.ro
+	rm -f $@
+	${AR} -cqs $@ $*.ro
+	rm -f $*.ro
