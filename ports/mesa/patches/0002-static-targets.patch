 endif
 
-libegl = shared_library(
+# stafeto: a static library; the program links the Mesa archives itself.
+libegl = static_library(
   egl_lib_name,
   files_egl,
   c_args : [
@@ -200,14 +201,8 @@ libegl = shared_library(
