# /etc/rc: the boot script. The launcher of the shell (ash-launcher, with this
# file as its argument in init's table) runs it with `ash` at each boot,
# beside the shell: the prompt does not wait for it.
#
# The files of /etc/rc.d run in the order of the list below, each one to its
# end, and each one waits for what it needs (the network) by itself. A service
# of the image joins by shipping a file in /etc/rc.d and putting its name in
# the list after the names whose work it needs: a server that reads
# authorized_keys of `user` goes after `ec2-key`, and `landing` goes before the web servers.

# The console, for the lines the scripts print.
exec </dev/null >/dev/console 2>&1

# The account files. The image's copies of /etc/passwd, /etc/group and /etc/shadow are immutable
# files of the file service, so `adduser`, `passwd` and the rest could not write them. The service
# `datakey` (an image with a data volume) has placed the merge of the image's files with those
# kept on the volume as /etc/<file>.new; without it a copy of the image's file is made here. The
# copies are moved over the image's and are ordinary files. An empty .new (a placement that
# failed halfway) counts as none.
(
    umask 077
    for f in passwd group shadow; do
        if [ ! -s "/etc/$f.new" ]; then
            cp -p "/etc/$f" "/etc/$f.new"
        fi
        mv -f "/etc/$f.new" "/etc/$f"
    done
)

for name in ec2-key dropbear landing web fast; do
    if [ -f "/etc/rc.d/$name" ]; then
        ash "/etc/rc.d/$name"
    fi
done
