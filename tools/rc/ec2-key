# /etc/rc.d/ec2-key: at each boot on EC2, the public key of the instance's key
# pair becomes the authorized_keys of the ordinary account `user` (its home is the
# one /etc/passwd names; the service `datakey` has put the home on the data volume
# before this script runs, when the image has one). Root has no key: it is reached
# from `user` with `doas`.
#
# The key comes from the instance metadata service (IMDSv2 only): a token
# from `PUT /latest/api/token`, then `meta-data/public-keys/0/openssh-key`
# with the token in the header. A refused token is the end: the script never
# asks without one. The requests are written by hand and sent with `nc`, as
# BusyBox `wget` has no PUT.
#
# Without a key nothing is written and one line says that SSH stays off.
# With one, one line names its type and comment. The key itself and the token
# are never printed.
#
# The key goes into a temporary file that `set -C` makes (it never writes through a
# link that is already there), which takes its owner and mode before it is moved into
# place. A home or a .ssh that is a symbolic link ends the script with nothing written.
#
# IMDS_HOST, IMDS_PORT, PASSWD_FILE, SSH_USER, SSH_DIR and SSH_CHOWN are for the checks of the image.

# No file name expansion anywhere: the words of a reply never become patterns.
set -f

host=${IMDS_HOST:-169.254.169.254}
port=${IMDS_PORT:-80}
account=${SSH_USER:-user}
passwd=${PASSWD_FILE:-/etc/passwd}
chown=${SSH_CHOWN:-chown}
nl='
'

say() {
    echo "ec2-key: $*"
}

# The account: its numbers and its home from the passwd file.
uid= gid= home=
while IFS=: read -r name _ id group _ dirname _; do
    if [ "$name" = "$account" ]; then
        uid=$id gid=$group home=$dirname
        break
    fi
done <"$passwd"
# The identifier is compared as a number: leading zeros come off first (`0000` is 0).
case $uid in
    '' | *[!0-9]*) uid=0 ;;
esac
while :; do
    case $uid in
        0?*) uid=${uid#0} ;;
        *) break ;;
    esac
done
if [ "${#uid}" -gt 9 ] || [ "$uid" -lt 1000 ]; then
    say "no account $account with an identifier of 1000 or more, SSH stays off"
    exit 1
fi
case $gid in
    '' | *[!0-9]*)
        say "the group of $account is not a number, SSH stays off"
        exit 1
        ;;
esac
case $home in
    /?* | /) ;;
    *)
        say "the home of $account is not an absolute path, SSH stays off"
        exit 1
        ;;
esac
case /$home/ in
    */../* | */./*)
        say "the home of $account holds a dot component, SSH stays off"
        exit 1
        ;;
esac
dir=${SSH_DIR:-$home/.ssh}

# imds METHOD PATH [HEADER]: sets `status` (empty when nothing answered, 000 when the status line is not three digits) and
# `body` from one request.
imds() {
    status= body=
    reply=$({
        printf '%s %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\nContent-Length: 0\r\n' "$1" "$2" "$host"
        if [ -n "$3" ]; then
            printf '%s\r\n' "$3"
        fi
        printf '\r\n'
    } | nc -w 5 "$host" "$port" | head -c 16384 | tr -d '\r')
    line=${reply%%"$nl"*}
    case $line in
        HTTP/*)
            set -- $line
            status=$2
            case $status in
                [0-9][0-9][0-9]) ;;
                *) status=000 ;;
            esac
            case $reply in
                *"$nl$nl"*) body=${reply#*"$nl$nl"} ;;
            esac
            ;;
    esac
}

# The token. The service is not reachable until the network has its address
# and route, so a missing answer is asked again for a minute.
token=
tries=0
while :; do
    imds PUT /latest/api/token 'X-aws-ec2-metadata-token-ttl-seconds: 300'
    if [ -n "$status" ]; then
        break
    fi
    tries=$((tries + 1))
    if [ "$tries" -ge 30 ]; then
        say "the metadata service did not answer, SSH stays off"
        exit 1
    fi
    sleep 2
done
if [ "$status" != 200 ] || [ -z "$body" ]; then
    say "the metadata service gave no token (HTTP $status), SSH stays off"
    exit 1
fi
case $body in
    '' | *[!A-Za-z0-9+/=_-]*)
        say "the metadata service gave a token that is not one word, SSH stays off"
        exit 1
        ;;
esac
token=$body

imds GET /latest/meta-data/public-keys/0/openssh-key "X-aws-ec2-metadata-token: $token"
token=
case $status in
    200) ;;
    404)
        say "the instance has no key pair, SSH stays off"
        exit 0
        ;;
    *)
        say "the metadata service gave no key (HTTP $status), SSH stays off"
        exit 1
        ;;
esac

key=$body
case $key in
    *[![:print:]]*) key= ;;
    ssh-* | ecdsa-sha2-* | sk-ssh-* | sk-ecdsa-*) ;;
    *) key= ;;
esac
# An OpenSSH key line is a few hundred bytes; the reply was cut at 16 KiB.
if [ "${#key}" -gt 8192 ]; then
    key=
fi
if [ -z "$key" ]; then
    say "the key is not one line of an OpenSSH public key, SSH stays off"
    exit 1
fi

umask 077
if [ -L "$home" ] || [ -L "$dir" ]; then
    say "$home or $dir is a symbolic link, SSH stays off"
    exit 1
fi
# A home that is not there yet (an image with no data volume, at each boot) is made empty.
if [ ! -d "$home" ]; then
    mkdir -p "$home" || exit 1
    $chown "$uid:$gid" "$home" || exit 1
    chmod 700 "$home"
    say "$home is made empty: it is in memory and is lost at a reboot"
fi
mkdir -p "$dir" || exit 1
$chown "$uid:$gid" "$dir" || exit 1
chmod 700 "$dir"
tmp=$dir/.authorized_keys.$$
rm -f "$tmp"
(
    set -C
    printf '%s\n' "$key" >"$tmp"
) || exit 1
$chown "$uid:$gid" "$tmp" || exit 1
chmod 600 "$tmp"
mv -f "$tmp" "$dir/authorized_keys" || exit 1

set -- $key
ktype=$1
if [ $# -ge 2 ]; then
    shift 2
else
    shift $#
fi
say "$ktype ${*:-(no comment)}"
