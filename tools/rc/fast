# /etc/rc.d/fast: nginx-fast on port 8080, a consumer of the switch of the network
# service. It starts only when the image has the program and its settings and
# `/etc/netd.conf` asks for the switch (the image of the try-out has it); otherwise one line
# says why it stays off. The settings are `/etc/nginx/nginx-fast-try.conf` (the image of the
# try-out: port 8080, two workers) or, without that file, the package's own. Regular nginx on
# 80 and 443 uses the sockets of the service and starts from /etc/rc.d/web.
#
# Console lines of a good start: `fast: nginx-fast on 8080` and, from the service,
# `net: switch` counters in `posix-net stat` with `consumers` above 0.

conf=/etc/nginx/nginx-fast-try.conf
if [ ! -f "$conf" ]; then
    conf=/etc/nginx/nginx-fast.conf
fi
if [ ! -x /bin/nginx-fast ] || [ ! -f "$conf" ]; then
    echo "fast: no nginx-fast in this image, 8080 stays off"
    exit 0
fi
if ! grep -q '^switch' /etc/netd.conf 2>/dev/null; then
    echo "fast: netd.conf has no switch, 8080 stays off"
    exit 0
fi
(
    tries=0
    while [ ! -s /etc/resolv.conf ] && [ "$tries" -lt 60 ]; do
        sleep 1
        tries=$((tries + 1))
    done
    echo "fast: nginx-fast on $(sed -n 's/^ *listen *\([0-9]*\);.*/\1/p' "$conf" | head -n 1)"
    /bin/nginx-fast -c "$conf"
) &
