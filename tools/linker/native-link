#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Link each native Cargo/ProbeLink ELF and verify its async unwind metadata."""
from pathlib import Path
import os
import re
import shlex
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

from cfi import Invalid, SpaceShortage, normalize_file, require


def llvm_tools(explicit):
    if explicit:
        linker = Path(explicit).resolve()
        return linker, linker.with_name('llvm-objdump')
    compiler = os.environ.get('RUSTC', 'rustc')
    sysroot = subprocess.check_output([compiler, '--print', 'sysroot'], text=True).strip()
    version = subprocess.check_output([compiler, '-vV'], text=True)
    host = re.search(r'^host: (.+)$', version, re.M)
    require(host is not None, 'selected rustc has no host triple')
    directory = Path(sysroot) / 'lib/rustlib' / host[1] / 'bin'
    return directory / 'rust-lld', directory / 'llvm-objdump'


def expand_response(arguments, depth=0):
    require(depth < 16, 'linker response files nest too deeply')
    result = []
    for argument in arguments:
        if argument.startswith('@'):
            result.extend(expand_response(shlex.split(Path(argument[1:]).read_text()), depth + 1))
        else:
            result.append(argument)
    return result


def main(arguments):
    explicit = None
    if arguments[:1] == ['--stafeto-real-linker']:
        require(len(arguments) >= 3, 'missing explicit linker or linker arguments')
        explicit, arguments = arguments[1], arguments[2:]
    linker, objdump = llvm_tools(explicit)
    require(linker.is_file() and objdump.is_file(), 'run rustup component add llvm-tools for the selected rustc')
    expanded = expand_response(arguments)
    outputs = [expanded[i + 1] for i, argument in enumerate(expanded[:-1]) if argument == '-o']
    require(len(outputs) == 1, 'native link requires exactly one -o output')
    if expanded[:1] == ['-flavor']:
        require(expanded[:2] == ['-flavor', 'gnu'], 'native link requires the GNU LLD flavor')
    else:
        # Stable rustc's ld flavor sends GNU arguments without a driver selector.
        arguments = ['-flavor', 'gnu', *arguments]
    output = Path(outputs[0])
    status = subprocess.run([str(linker), *arguments]).returncode
    if status:
        return status
    try:
        try:
            normalize_file(output, objdump)
        except SpaceShortage:
            # Exactly one retry, only after complete metadata/instruction validation.
            # The generated script reserves bounded zero capacity in the original EH.
            with tempfile.TemporaryDirectory(prefix='stafeto-eh-') as directory:
                script = Path(directory) / 'reserve.ld'
                script.write_text('SECTIONS { .eh_frame : { *(.eh_frame) . += 512; } } INSERT AFTER .eh_frame_hdr;\n')
                status = subprocess.run([str(linker), *arguments, '-T', str(script)]).returncode
                if status:
                    output.unlink(missing_ok=True)
                    return status
                normalize_file(output, objdump)
    except BaseException:
        # A failed link must not leave a usable, unverified final Cargo artifact.
        output.unlink(missing_ok=True)
        raise
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as error:
        print(f'native async CFI validation failed: {error}', file=sys.stderr)
        sys.exit(1)
