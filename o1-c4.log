# configuration file /etc/nginx/nginx-fast.conf:
# The settings of nginx on the TCP/IP stack in its own process
# (packages/nginx-fast.toml, ports/f-stack). The master (the superuser) holds
# the listening ports with the network service's switch when it binds, and
# the workers run as nobody on the descriptions they inherit. With one
# worker the listener is the stack's own; with several (the probe's 4-worker
# variant sets worker_processes 4) the switch spreads new
# connections over them by a hash of the four addresses. The address of a
# listener is the shared address (0.0.0.0 means it). The probe's variants are
# made from this file (xtask/src/fast_nginx.rs).
user root;
worker_processes 1;
daemon off;
master_process on;
error_log stderr notice;
pid /var/run/nginx-fast.pid;
# A worker that is told to quit waits this long for its connections.
worker_shutdown_timeout 5s;
events { use epoll; worker_connections 1024; accept_mutex off; multi_accept off; }
http {
    types { text/html html htm; text/plain txt; application/octet-stream bin; }
    default_type application/octet-stream;
    access_log off;
    sendfile off;
    tcp_nopush off;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 100000;
    output_buffers 2 32k;
    open_file_cache max=1000 inactive=60s;
    server {
        listen 80;
        server_name _;
        root /www;
        location / { }
        # Bench only: 1,024 bytes from memory, no file (net-bench workload w8).
        location = /mem1k { return 200 ""; }
    }
}

end-ok-config
