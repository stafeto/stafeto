+// stafeto: lfs_stat_ and the custom attribute of the entry, from the same
+// metadata pair: one lookup of the path, and the gets of the name, the
+// structure and the attribute.
+static int lfs_stat_attr_(lfs_t *lfs, const char *path, struct lfs_info *info,
+        uint8_t type, void *buffer, lfs_size_t size, lfs_ssize_t *res) {
+    lfs_mdir_t cwd;
+    lfs_stag_t tag = lfs_dir_find(lfs, &cwd, &path, NULL);
+    if (tag < 0) {
+        return (int)tag;
+    }
+
+    // only allow trailing slashes on dirs
+    if (strchr(path, '/') != NULL
+            && lfs_tag_type3(tag) != LFS_TYPE_DIR) {
+        return LFS_ERR_NOTDIR;
+    }
+
+    uint16_t id = lfs_tag_id(tag);
+    int err = lfs_dir_getinfo(lfs, &cwd, id, info);
+    if (err) {
+        return err;
+    }
+
+    if (id == 0x3ff) {
+        // special case for root
+        id = 0;
+        err = lfs_dir_fetch(lfs, &cwd, lfs->root);
+        if (err) {
+            return err;
+        }
+    }
+
+    return lfs_dir_getattr_(lfs, &cwd, id, type, buffer, size, res);
+}
