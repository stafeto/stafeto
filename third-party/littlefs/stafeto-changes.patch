+                NULL, &file->cache, sizeof(head),
+                head, 4*skip, &head, sizeof(head));
+        head = lfs_fromle32(head);
+        if (err) {
+            return err;
+        }
+
+        current -= 1 << skip;
+        lfs_ctz_hint_add(hints, limit, current, head);
+    }
+
+    *block = head;
+    *off = pos;
+    return 0;
+}
