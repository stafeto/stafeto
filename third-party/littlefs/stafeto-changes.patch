+// The kind and the custom attribute of one entry of a path
+//
+// stafeto: see lfs_path_attrs. res is the size of the attribute on disk, or
+// LFS_ERR_NOATTR when the entry has none.
+struct lfs_path_attr {
+    lfs_ssize_t res;
